{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gozareshgir Desktop",
  "version": "0.1.0",
  "identifier": "ir.gozareshgir.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "گزارش‌گیر - میز کار",
        "label": "main",
        "url": "index.html?view=main",
        "width": 940,
        "height": 680,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true
      },
      {
        "title": "Notch",
        "label": "notch",
        "url": "index.html?view=notch",
        "width": 540,
        "height": 38,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
